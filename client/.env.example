# Veyra Client Environment Variables
# Copy to .env for local development; never commit real credentials.

# Supabase (Project URL and Anon/Public Key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL (optional for direct BaaS, defaults to /api in production)
VITE_API_BASE_URL=http://localhost:5000/api

# ImageKit (Public Key and Endpoint URL)
VITE_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-endpoint
