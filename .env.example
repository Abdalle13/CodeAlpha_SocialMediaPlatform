# Copy to .env locally; never commit .env or real credentials.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Client values (public; RLS must protect all exposed data)
VITE_SUPABASE_URL=https://replace-with-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_supabase_publishable_or_anon_key
VITE_API_BASE_URL=http://localhost:5000/api
VITE_IMAGEKIT_PUBLIC_KEY=replace_with_imagekit_public_key
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/replace_with_endpoint

# Server-only values (STRICTLY CONFIDENTIAL)
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
IMAGEKIT_PUBLIC_KEY=replace_with_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=replace_with_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/replace_with_endpoint
IMAGEKIT_UPLOAD_FOLDER=/veyra
ADMIN_BOOTSTRAP_SECRET=replace_with_strong_random_secret_for_initial_bootstrap
